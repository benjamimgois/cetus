            try:
                network = ipaddress.ip_network(f"{ip}/{prefix_len}", strict=False)
                self.scan_network_input.setText(str(network.network_address))
                self.scan_mask_combo.setCurrentText(str(prefix_len))
            except ValueError:
                parts = ip.split('.')
