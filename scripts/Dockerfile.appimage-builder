FROM ubuntu:22.04

# ── Environment ────────────────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── System packages ────────────────────────────────────────────────────────────
# Keep the list intentionally minimal — quick-sharun captures runtime deps
# automatically via strace, so we only need the packages installed here to
# satisfy build-time imports and the strace tracing run.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Toolchain / utilities (ar is part of binutils, already in build-essential)
    build-essential wget curl git strace file binutils patchelf \
    xz-utils zstd \
    # Python runtime
    python3 python3-pip python3-dev \
    # PyQt6 system libraries (Qt6 base, SVG, Wayland)
    libgl1 libglib2.0-0 libdbus-1-3 libegl1 \
    libfontconfig1 libfreetype6 libxcb1 libx11-6 libxext6 \
    libxrender1 libxi6 libxkbcommon0 libxkbcommon-x11-0 \
    libxcb-xinerama0 libxcb-cursor0 \
    # External tools bundled in the AppImage (vncviewer optional)
    iperf3 freerdp2-x11 \
    # Virtual display for the strace tracing run
    xvfb xauth \
    # AppImage packing
    squashfs-tools \
    # fuse for running AppImages inside the container (optional)
    libfuse2 \
 && rm -rf /var/lib/apt/lists/*

# ── Python packages ────────────────────────────────────────────────────────────
# PyQt6 from PyPI ships its own bundled Qt6 libs (via PyQt6-Qt6 wheel),
# so we get a self-contained Qt6 that doesn't depend on system Qt6 packages.
RUN pip3 install --no-cache-dir \
    PyQt6 \
    paramiko \
    pyte \
    speedtest-cli \
    standard-telnetlib

# ── zsyncmake stub ─────────────────────────────────────────────────────────────
# quick-sharun calls zsyncmake for delta-update metadata; we don't need it.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/zsyncmake \
 && chmod +x /usr/local/bin/zsyncmake

# ── FUSE (for running AppImages inside the container, optional) ────────────────
RUN echo 'user_allow_other' >> /etc/fuse.conf 2>/dev/null || true

WORKDIR /workspace
